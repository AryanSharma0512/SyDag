# Frontend build settings. Vite bakes these in at build time.

# VITE_DEMO_MODE: "false" makes the app fetch from the SoilSignal API
# instead of the bundled demo data in src/mock.
VITE_DEMO_MODE="true"

# VITE_API_BASE_URL: where the API lives. Defaults to same-origin "/api",
# which the reverse proxy (production) or Vite dev proxy (local) forwards.
# VITE_API_BASE_URL="/api"

# API_PROXY_TARGET: backend URL the Vite dev server forwards /api to.
# API_PROXY_TARGET="http://localhost:8000"
